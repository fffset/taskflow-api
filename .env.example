# App
NODE_ENV=development
PORT=8000
API_PREFIX=api
API_VERSION=1

# Database
DATABASE_URL=postgresql://taskflow:taskflow_pass@localhost:5432/taskflow_db
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_pass
POSTGRES_DB=taskflow_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://taskflow:taskflow_pass@localhost:5672
RABBITMQ_USER=taskflow
RABBITMQ_PASS=taskflow_pass

# JWT
JWT_SECRET=taskflow_jwt_secret_change_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=taskflow_refresh_secret_change_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# 2FA
TWO_FACTOR_SECRET=taskflow_2fa_secret

# Frontend
FRONTEND_URL=http://localhost:3000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Email (via RabbitMQ worker)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@taskflow.com
